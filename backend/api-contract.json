{
  "contractVersion": "1.1.0",
  "basePath": "/api",
  "errorShape": { "required": ["error"] },
  "routes": {
    "v1/auth/login": { "handler": "login.php", "methods": ["POST"], "auth": false },
    "v1/auth/register": { "handler": "register.php", "methods": ["POST"], "auth": false },
    "v1/auth/forgot-password": { "handler": "forgot_password.php", "methods": ["POST"], "auth": false },
    "v1/auth/reset-password": { "handler": "reset_password.php", "methods": ["POST"], "auth": false },
    "v1/users/me": { "handler": "profile.php", "methods": ["PUT"], "auth": true },
    "v1/users": { "handler": "users_list.php", "methods": ["GET"], "auth": true },
    "v1/users/search": { "handler": "search_users.php", "methods": ["GET"], "auth": true },
    "v1/chats": { "handler": "chats.php", "methods": ["GET", "POST"], "auth": true },
    "v1/groups": { "handler": "groups.php", "methods": ["GET", "POST", "PUT", "DELETE"], "auth": true },
    "v1/group-members": { "handler": "group_members.php", "methods": ["GET", "POST", "DELETE"], "auth": true },
    "v1/messages": { "handler": "messages.php", "methods": ["GET", "POST"], "auth": true },
    "v1/messages/edit": { "handler": "edit_message.php", "methods": ["POST"], "auth": true },
    "v1/polls": { "handler": "polls.php", "methods": ["POST"], "auth": true },
    "v1/attachments/upload": { "handler": "upload_attachment.php", "methods": ["POST"], "auth": true, "contentType": "multipart/form-data" },
    "v1/attachments": { "handler": "attachment.php", "methods": ["GET"], "auth": true },
    "v1/attachment-requests": { "handler": "attachment_requests.php", "methods": ["GET"], "auth": true },
    "v1/attachment-requests/request": { "handler": "request_attachment_download.php", "methods": ["POST"], "auth": true },
    "v1/attachment-requests/respond": { "handler": "respond_attachment_download.php", "methods": ["POST"], "auth": true },
    "v1/contacts": { "handler": "contacts.php", "methods": ["GET"], "auth": true },
    "v1/integrations/google/connect": { "handler": "google/connect.php", "methods": ["GET"], "auth": true },
    "v1/integrations/google/status": { "handler": "google/status.php", "methods": ["GET"], "auth": true },
    "v1/integrations/google/sync": { "handler": "google/sync.php", "methods": ["POST"], "auth": true },
    "v1/integrations/google/contacts": { "handler": "google/contacts.php", "methods": ["GET"], "auth": true },
    "v1/presence/heartbeat": { "handler": "heartbeat.php", "methods": ["POST"], "auth": true },
    "v1/health": { "handler": "health.php", "methods": ["GET"], "auth": false },
    "v1/calls": { "handler": "calls.php", "methods": ["POST"], "auth": true },
    "v1/live-locations": { "handler": "live_location.php", "methods": ["POST"], "auth": true },
    "v1/stories": { "handler": "stories.php", "methods": ["GET", "POST"], "auth": true },
    "v1/media": { "handler": "media.php", "methods": ["GET"], "auth": true },
    "v1/media/upload": { "handler": "media_upload.php", "methods": ["POST"], "auth": true },
    "v1/invitations/join": { "handler": "join.php", "methods": ["GET"], "auth": false }
  }
}
