    "@cloudcomai/auth": "workspace:*",
    "@cloudcomai/chat-core": "workspace:*",
    "expo": "^57.0.0",
    "expo-audio": "~57.0.4",
    "expo-contacts": "~57.0.4",
    "expo-file-system": "~57.0.6",
    "expo-image-picker": "~57.0.16",
    "expo-location": "~57.0.16",
    "expo-screen-capture": "~57.0.2",
    "expo-sharing": "~57.0.18",
    "expo-video": "~57.0.3",
    "expo-secure-store": "~57.0.2",
    "expo-document-picker": "~57.0.1",
    "expo-notifications": "~57.0.15",
    "expo-updates": "~57.0.11",
    "react": "19.2.3",
    "react-native": "0.86.0",
    "react-native-safe-area-context": "~5.7.0"
