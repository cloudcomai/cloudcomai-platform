{
  "name": "@cloudcomai/mobile",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "CloudComAI React Native and Expo mobile application foundation",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
